# BookCraft AI - Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration (Optional - for cloud sync)
# To find these values:
# 1. Go to your Supabase project dashboard at https://supabase.com
# 2. Navigate to Settings → API
# 3. Copy your Project URL and anon/public key
# For detailed instructions, see: SUPABASE_DATABASE_SETUP.md

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Direct Database Connection (for migrations and database admin)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres?sslmode=require
# Find your database password in: Supabase Dashboard → Settings → Database
# See SUPABASE_DATABASE_SETUP.md for detailed instructions
# DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Application Configuration
VITE_APP_NAME=BookCraft AI
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_DEBUG_LOGGING=false
VITE_VALIDATE_API_KEYS=true

# API Rate Limiting
VITE_API_RATE_LIMIT=100
VITE_API_RATE_WINDOW=3600000

# Kroki Diagram Service (Multi-Format Diagram Rendering)
# Kroki provides rendering for D2, Graphviz, PlantUML, Nomnoml, and Mermaid diagrams
# Default: https://kroki.io (public instance)
# You can also host your own Kroki instance: https://docs.kroki.io/kroki/setup/install/
VITE_KROKI_API_URL=https://kroki.io
VITE_DIAGRAM_CACHE_TTL=3600000

# Note: Users configure their own API keys in the app settings
# These are NOT stored in environment variables for security
