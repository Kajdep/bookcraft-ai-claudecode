# BookCraft AI Environment Configuration
# Fill in your actual API keys below

# === REQUIRED API KEYS ===
# OpenRouter API for AI text generation
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1

# Gemini API for advanced AI features
VITE_GEMINI_API_KEY=
VITE_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com

# === IMAGE GENERATION APIS (Optional) ===
# DALL-E API (OpenAI) for image generation
VITE_DALLE_API_KEY=

# Stability AI for image generation (Stable Diffusion)
VITE_STABILITY_API_KEY=

# === OPTIONAL INTEGRATIONS ===
# LanguageTool API for grammar checking
VITE_LANGUAGETOOL_API_KEY=
VITE_LANGUAGETOOL_ENDPOINT=https://api.languagetool.org

# Grammarly API for advanced grammar checking
VITE_GRAMMARLY_API_KEY=
VITE_GRAMMARLY_ENDPOINT=https://api.grammarly.com

# Web scraping service (ScrapingBee, Scrapfly, etc.)
VITE_SCRAPING_API_KEY=
VITE_SCRAPING_ENDPOINT=https://app.scrapingbee.com

# Document parsing service (for PDF/DOCX analysis)
VITE_DOCUMENT_PARSER_API_KEY=
VITE_DOCUMENT_PARSER_ENDPOINT=https://api.documentparser.com

# Fact-checking service (Factiva, NewsAPI, etc.)
VITE_FACTCHECK_API_KEY=
VITE_FACTCHECK_ENDPOINT=https://api.factcheck.org

# === SUPABASE CLOUD STORAGE ===
# Supabase for cloud sync and backup
VITE_SUPABASE_URL=https://imdrttimzxvgqrpldtcc.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImltZHJ0dGltenh2Z3FycGxkdGNjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTkzMjkyMDgsImV4cCI6MjA3NDkwNTIwOH0.UKnuNkjM4fPppoJnlnYLc7QGSmf6-pTXe8hEDE6EyvQ

# === APPLICATION CONFIGURATION ===
# Default AI model settings
VITE_DEFAULT_AI_MODEL=nvidia/nemotron-nano-9b-v2:free
VITE_DEFAULT_TEMPERATURE=0.7
VITE_DEFAULT_MAX_TOKENS=4000

# Application settings
NODE_ENV=development
VITE_APP_NAME=BookCraft AI
VITE_APP_VERSION=1.0.0

# === SECURITY SETTINGS ===
# Enable/disable API key validation
VITE_VALIDATE_API_KEYS=true

# Enable/disable development features
VITE_ENABLE_DEBUG_LOGGING=false
VITE_ENABLE_ANALYTICS=true

# Rate limiting
VITE_API_RATE_LIMIT=100
VITE_API_RATE_WINDOW=3600000
