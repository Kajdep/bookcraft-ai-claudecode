# BookCraft AI Environment Configuration
# Fill in your actual API keys below

# === REQUIRED API KEYS ===
# OpenRouter API for AI text generation
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1

# Gemini API for advanced AI features
GEMINI_API_KEY=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com

# === IMAGE GENERATION APIS (Optional) ===
# DALL-E API (OpenAI) for image generation
DALLE_API_KEY=

# Stability AI for image generation (Stable Diffusion)
STABILITY_API_KEY=

# === OPTIONAL INTEGRATIONS ===
# LanguageTool API for grammar checking
LANGUAGETOOL_API_KEY=
LANGUAGETOOL_ENDPOINT=https://api.languagetool.org

# Grammarly API for advanced grammar checking
GRAMMARLY_API_KEY=
GRAMMARLY_ENDPOINT=https://api.grammarly.com

# Web scraping service (ScrapingBee, Scrapfly, etc.)
SCRAPING_API_KEY=
SCRAPING_ENDPOINT=https://app.scrapingbee.com

# Document parsing service (for PDF/DOCX analysis)
DOCUMENT_PARSER_API_KEY=
DOCUMENT_PARSER_ENDPOINT=https://api.documentparser.com

# Fact-checking service (Factiva, NewsAPI, etc.)
FACTCHECK_API_KEY=
FACTCHECK_ENDPOINT=https://api.factcheck.org

# === APPLICATION CONFIGURATION ===
# Default AI model settings
DEFAULT_AI_MODEL=nvidia/nemotron-nano-9b-v2:free
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=4000

# Application settings
NODE_ENV=development
VITE_APP_NAME=BookCraft AI
VITE_APP_VERSION=1.0.0

# === SECURITY SETTINGS ===
# Enable/disable API key validation
VALIDATE_API_KEYS=true

# Enable/disable development features
ENABLE_DEBUG_LOGGING=false
ENABLE_ANALYTICS=true

# Rate limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=3600000